# Copie este arquivo para .env e preencha os valores reais.
# .env nunca deve ser commitado (ja esta no .gitignore).

# Email do CEO que recebe o link do painel publicado
PAINEL_CEO_EMAIL=ceo@fucape.br

# Como enviar o email: "graph" (default, via Microsoft Graph API) ou "outlook"
# (via Outlook Desktop logado na maquina, usando pywin32 - nao precisa das
# variaveis GRAPH_* abaixo nesse caso, so PAINEL_CEO_EMAIL).
PAINEL_METODO_ENVIO=graph

# Necessario so se PAINEL_METODO_ENVIO=graph.
# Registro do aplicativo no Entra ID (Azure Portal > App registrations)
# Necessario: permissao de aplicativo Mail.Send no Microsoft Graph, com admin consent
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Opcional - caixa compartilhada que envia o email (default: relatorios@fucape.br)
GRAPH_REMETENTE=relatorios@fucape.br

# Opcional - se definida (qualquer valor), o botao Enviar simula o deploy no
# Netlify e o envio de email, sem gastar credito nenhum nem mandar email real.
# Use pra testar o fluxo; comente/apague essa linha quando for enviar de verdade.
# PAINEL_MODO_TESTE=1
